# ==============================================================================
# FinOS Environment Configuration Template
# Copy this file to .env and provide your deployment secrets.
# ==============================================================================

# Database Connection
# SQLite (Local Development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production / Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://finos_user:password@localhost:5432/finos_db?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional AI LLM Integrations (Falls back gracefully to deterministic engines if omitted)
# GEMINI_API_KEY="your-gemini-api-key-here"
# OPENAI_API_KEY="your-openai-api-key-here"

# NextAuth / Session Secret
# NEXTAUTH_SECRET="generate-a-32-byte-hex-string-for-production"
# NEXTAUTH_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

